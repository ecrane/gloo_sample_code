#
# Integer object.
#
integer [can] :

  # 
  # The integer value.
  # 
  x [integer] : 0

  # 
  # Do some basic tests with it
  # 
  on_load [script] :
    show ^.x
    tell ^.x to inc
    show ^.x
    put ^.x * 10 into ^.x
    show ^.x

    # Show a random number
    tell ^.x to randomize
    show 'Random number (up to 100 by default): ' + ^.x

    tell ^.x to randomize(6)
    tell ^.x to inc
    show '6-sided dice: ' + ^.x


  # An uninitialized integer.
  y [integer] :