#
# Password object.
#
# A 'password' generates, hashes (BCrypt), and verifies a password.
# It has three string children:
#
#   salt        optional salt, mixed in before hashing
#   password    the plaintext password to work on
#   hash        the BCrypt hash - written by 'hash', read by 'check'
#
# Messages:
#   generate ({len})   put a random alphanumeric password in 'password'
#                      (default length 7); the password also lands in 'it'
#   hash               BCrypt-hash salt + password into 'hash'
#   check              does salt + password match 'hash'?  result in 'it'
#
# The plaintext password is never stored - only the hash is kept, and
# 'check' compares a fresh attempt against it.
#
password [can] :

  #
  # A password for one account.  Store the salt and hash; leave the
  # plaintext password blank between checks.
  #
  account [password] :
    salt [string] : account-42
    password [string] :
    hash [string] :

  on_load [script] :
    run password.set_and_store
    run password.verify
    run password.generate_one
    show 'Done.'

  #
  # Set a password and store only its hash.
  #
  set_and_store [script] :
    show 'Set and store:' (white)

    put 'correct horse battery staple' into password.account.password
    tell password.account to hash

    show 'stored hash:'
    show password.account.hash

  #
  # A later login attempt: put the attempt in 'password' and check.
  #
  verify [script] :
    show 'Verify:' (white)

    put 'wrong guess' into password.account.password
    show 'check with the wrong password:'
    tell password.account to check
    show it

    put 'correct horse battery staple' into password.account.password
    show 'check with the correct password:'
    tell password.account to check
    show it

  #
  # 'generate' makes a random password (and puts it in 'it').
  #
  generate_one [script] :
    show 'Generate:' (white)

    tell password.account to generate
    show 'default length (7):'
    show password.account.password

    tell password.account to generate ( 16 )
    show 'length 16:'
    show password.account.password
