#
# Repeat for X number of times.
#
repeat [can] :

  s [string] :

  on_load [script] :
    put $.screen_cols / 2 into repeat.x.times
    tell repeat.x to run
    show repeat.s
    tell repeat.y to run
    show repeat.s

  x [repeat] :
    times [integer] : 30
    index [integer] : 0
    do [script] : put repeat.s + '-' into repeat.s

  y [repeat] :
    times [integer] : 10
    index [integer] : 0
    do [script] : show repeat.y.index
