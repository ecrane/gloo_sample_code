#
# Base object checks.
#
obj [container] :

	msg [string] : 
	
	on_load [script] : 
		show
		show 'Does the obj container have children?'
		check obj for contains?
		show it

		show
		show 'Is the msg blank?'
		check obj.msg for blank?
		show it

		show
		put 'Hello, world!' into obj.msg
		show obj.msg
		show 'Is the msg still blank?'
		check obj.msg for blank?
		show it
		show

		show 'Which file was obj loaded from, and what folder is it in?'
		check obj for source_file
		show it
		check obj for source_dir
		show it
		show