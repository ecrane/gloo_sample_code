#
# Tell verb.
#
# 'tell' sends a message to an object.  'check' (see verb/check.gloo)
# is the exact same operation - the two names exist so gloo code reads
# like natural communication.  By convention:
#
#   tell {obj} to {message}     - trigger an action / change state
#   check {obj} for {message}   - investigate state (a yes/no question)
#
tell [container] :

  #
  # Send messages to objects.  Available messages depend on the type
  # of object.  These are all actions, so they use 'tell'.
  #
  on_load [script] :
    tell tell.code to run

    tell tell.str to up
    show tell.str

    put 'LOWER CASE' into tell.str
    tell tell.str to down
    show tell.str

    tell tell.i to inc
    show tell.i

  i [integer] : 42
  str [string] : upper case

  # 
  # Scripts can be run.
  # 
  code [script] :
    show "Code was run!"
