# 
# Break out of a script.
# 
#   break       - end the script it's written in
#   break loop  - in a loop's do script, also end the whole loop
# 
break [can] :

  x [bool] : false

  on_load [script] :
    if ^.x then break
    show 'should see this'

    show 'break skips an item:'
    tell ^.skip to run
    show 'break loop ends the loop:'
    tell ^.early to run

    put true into ^.x
    if ^.x then break
    show 'should not see this'

  # In a loop's do script, break skips the rest of that pass and the
  # loop goes on. Shows 0, 1, 3, 4.
  skip [repeat] :
    times [int] : 5
    index [int] : 0
    do [script] :
      if break.skip.index = 2 then break
      show break.skip.index

  # break loop ends the whole loop; the script that ran it carries on.
  # Shows 0, 1.
  early [repeat] :
    times [int] : 5
    index [int] : 0
    do [script] :
      if break.early.index = 2 then break loop
      show break.early.index
