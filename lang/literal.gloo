#
# Examples of literal values.
#
literal [can] :

  s [string] : 
  i [integer] : 
  d [decimal] : 
  b [boolean] : 

  # 
  # Use Literals to assign values
  # 
	on_load [script] :

    # String literals
    put 'Hello world.' into ^.s
    show ^.s
    put "You're Awesome!" into ^.s
    show ^.s

    # A quote of the other kind inside needs no escaping -- this is
    # the usual way to write a JSON literal.
    put '{"lang":"gloo","ok":true}' into ^.s
    show ^.s

    # A quote of the same kind inside is escaped with a backslash.
    put "she said \"hi\"" into ^.s
    show ^.s

    # Number literals
    put 1 into ^.i
    show ^.i
    put 3.12 into ^.d
    show ^.d

    # Other ways to write a number. Leading zeros are fine (007 is 7,
    # never octal); a decimal can have trailing zeros, start with a dot,
    # or have an exponent. Not numbers: 5. (a path start), 1_000, 0x1A.
    put 007 into ^.i
    show ^.i
    put 2.50 into ^.d
    show ^.d
    put .5 into ^.d
    show ^.d
    put 1.0e3 into ^.d
    show ^.d

    # Boolean literals
    # Boolean literals are case insensitive
    put TRUE into ^.b
    show ^.b
    put false into ^.b
    show ^.b
    
