#
# Example of object naming.
#
# NOTE that the second 'a' and the 'A' lines name the same object as
# the first: 'naming.a' is 'First A', and loading warns that the other
# two values are ignored.
#
naming [container] : 

	on_load [script] : 
		show naming.msg!$%
		show naming.a
		show naming.1
		show naming.string

	msg!$% [string] : Naming stuff
	a [string] : First A
	a [string] : Second A
	A [string] : Capital
	1 [string] : One
	string [string] : A name can be an object type or a verb
