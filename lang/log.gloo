#
# Show multiple messages in loggers
#
# To See the error logs, do something like this:
# 
#  > tail -f ~/.gloo/logs/gloo.log
#  > tail -f ~/gloo/logs/error.log 
# 
log [can] :

  level [string] : info
	msg [string] : info from var

	on_load [script] :
		log "debug implicit"
		log "debug explicit" (debug)
		log "info" (info)
		log "warn" (warn)
		log "error" (error)
		log log.msg (log.level)