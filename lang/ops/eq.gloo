#
# Compare two values.
#
eq [can] :

  a [string] : A
  b [string] : B
  c [string] : A

	on_load [script] :
    show '---------- str -------------'
    show 'is ' + ^.a + ' equal to ' + ^.b + '?' (white)
    show ^.a = ^.b
    show

    show 'is ' + ^.a + ' equal to ' + ^.c + '?' (white)
    show ^.a = ^.c
    show

    if ^.a = ^.b then show 'a and b are equal'
    if ^.a = ^.c then show 'a and c are equal'
    show

    show '---------- int -------------'
    show 'is 1 = 2?' (white)
    show 1 = 2
    show

    show 'is 1 = 1?' (white)
    show 1 = 1
    show

    show '---------- dec -------------'
    show 'is 1.1 = 1.0?' (white)
    show 1.1 = 1.0
    show

    show 'is 1.3 = 1.3?' (white)
    show 1.3 = 1.3
    show

    show '---------- int and dec ---'
    show 'is 1 = 1.9?' (white)
    show 1 = 1.9
    show

    show 'is 1 = 1.0?' (white)
    show 1 = 1.0
    show

    show '---------- int and str ---'
    show "is 3 = '3'?" (white)
    show 3 = '3'
    show

    show "is '3.0' = 3?" (white)
    show '3.0' = 3
    show

    show "is 3 = 'abc'?" (white)
    show 3 = 'abc'
    show

    show 'Done.'
