#
# Compare two values.
# 
eq [can] :

  a [string] : A
  b [string] : B
  c [string] : A

	on_load [script] :
    show '---------- str -------------'
    show 'is ' + ^.a + ' equal to ' + ^.b + '?' (white)
    show ^.a = ^.b
    show

    show 'is ' + ^.a + ' equal to ' + ^.c + '?' (white)
    show ^.a = ^.c
    show

    if ^.a = ^.b then show 'a and b are equal'
    if ^.a = ^.c then show 'a and c are equal'
    show
    
    show '---------- int -------------'
    show 'is 1 = 2?' (white)
    show 1 = 2
    show

    show 'is 1 = 1?' (white)
    show 1 = 1
    show

    show '---------- dec -------------'
    show 'is 1.1 = 1.0?' (white)
    show 1.1 = 1.0
    show

    show 'is 1.3 = 1.3?' (white)
    show 1.3 = 1.3
    show

    show 'Done.'
