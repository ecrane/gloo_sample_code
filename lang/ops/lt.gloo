#
# Test the Less Than operator.
#
lt [can] :

	on_load [script] :
    show '---------- str -------------'
    show "is 'abc' < 'abd'?" (white)
    show 'abc' < 'abd'
    show

    show "is 'B' < 'a'?" (white)
    show 'B' < 'a'
    show

    show "is 'A' < 'a'?" (white)
    show 'A' < 'a'
    show

    show '---------- int -------------'
    show 'is 2 < 1?' (white)
    show 2 < 1
    show

    show 'is 1 < 1?' (white)
    show 1 < 1
    show

    show 'is 1 < 2?' (white)
    show 1 < 2
    show

    show '---------- dec -------------'
    show 'is 1.0 < 1.1?' (white)
    show 1.0 < 1.1
    show

    show 'is 1.3 < 1.3?' (white)
    show 1.3 < 1.3
    show

    show 'is 2.0 < 1.3?' (white)
    show 2.0 < 1.3
    show

    show '---------- int and dec ---'
    show 'is 1 < 1.5?' (white)
    show 1 < 1.5
    show

    show 'is 2 < 1.5?' (white)
    show 2 < 1.5
    show

    show 'Done.'
