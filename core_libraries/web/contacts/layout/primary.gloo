#
# The layout wrapped around every page.
#
# render_layout renders the children in order, with <%= head %> and
# <%= body %> supplied by the page being shown.
#

layout [can] :
  primary [part] :
    content [can] :

      html_open [text] : BEGIN
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%= head %>
  <%= favicon_tag %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <%= css_tag 'contacts.css' %>
</head>
<body>
END

      nav [alias] : shared.nav

      body_open [text] : <main class="container">
      body [string] : <%= body %>
      body_close [text] : </main>

      footer [alias] : shared.footer

      html_close [text] : BEGIN
</body>
</html>
END
