#
# Shown when a request fails on the server.
# The server sends it with a 500 (app.svr.error points here).
#

page [can] :
  err [page] :

    head [e] :
      content [can] :
        title [e] : Something Went Wrong

    body [e] :
      content [can] :
        main [text] : BEGIN
<div class="py-5 text-center">
  <h2>Something went wrong</h2>
  <p class="text-muted">The server couldn't finish that request.</p>
  <a href="/" class="btn btn-primary">Go home</a>
</div>
END
