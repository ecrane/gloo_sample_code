#
# Inline "add a note" form on the person detail page.
#
# person_id is set by page/people/show.gloo before it renders. The
# form posts to /notes (the notes 'create' page).
#

page [can] :
  people [can] :
    _add_note [part] :

      params [container] :
        person_id [int] :

      content [text] : BEGIN
<form class="mb-4" method="post" action="/notes">
  <input type="hidden" name="person_id" value="<%= person_id %>" />
  <div class="mb-2">
    <input type="text" name="title" class="form-control form-control-sm"
      placeholder="Title (optional)" />
  </div>
  <div class="mb-2">
    <textarea name="body" rows="3" class="form-control form-control-sm"
      placeholder="What happened? (markdown supported)" required></textarea>
  </div>
  <div class="d-flex align-items-center gap-2">
    <input type="date" name="contacted_at" class="form-control form-control-sm" style="width:auto" />
    <button type="submit" class="btn btn-sm btn-primary">Add note</button>
  </div>
</form>
END
