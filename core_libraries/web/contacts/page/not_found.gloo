#
# Shown for any route that doesn't resolve.
# The server sends it with a 404 (app.svr.not_found points here).
#

page [can] :
  not_found [page] :

    head [e] :
      content [can] :
        title [e] : Not Found

    body [e] :
      content [can] :
        main [text] : BEGIN
<div class="py-5 text-center">
  <h2>Not found</h2>
  <p class="text-muted">That page doesn't exist.</p>
  <a href="/" class="btn btn-primary">Go home</a>
</div>
END
